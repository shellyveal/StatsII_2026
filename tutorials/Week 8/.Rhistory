facet_grid(gender ~ year)
ord.log <- polr(attitude ~ ., data = workingMoms, Hess = TRUE)
summary(ord.log)
# Calculate a p value
ctable <- coef(summary(ord.log))
# Calculate a p value
ctable <- coef(summary(ord.log))
p <- pnorm(abs(ctable[,"t value"]), lower.tail = FALSE) * 2
ctable
